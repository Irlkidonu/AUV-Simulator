    <!-- Man-made structure. A seabed with only rocks on it has no scale and no
         reason to be surveyed; a wreck and a pipeline give the scene both, and
         they are what vehicles of this class are actually sent to inspect.
         Both are generated meshes (scripts/make_scenery.py), so nothing is
         downloaded and nothing is licensed from anywhere. -->
    <model name="wreck">
      <static>true</static>
      <pose>7.5 -8.5 -19.45 0.13 0.06 -0.62</pose>
      <link name="link">
        <visual name="v">
          <geometry><mesh><uri>model://uuv_mode_aware_navigation/models/meshes/wreck.obj</uri><scale>1 1 1</scale></mesh></geometry>
          <material><ambient>0.09 0.10 0.09 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <specular>0.06 0.06 0.06 1</specular>
            <pbr><metal><roughness>0.95</roughness><metalness>0.35</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="pipeline">
      <static>true</static>
      <pose>-3.0 9.5 -19.75 0 0 0.28</pose>
      <link name="link">
        <visual name="v">
          <geometry><mesh><uri>model://uuv_mode_aware_navigation/models/meshes/pipeline.obj</uri><scale>1 1 1</scale></mesh></geometry>
          <material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.30 0.30 0.29 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr><metal><roughness>0.85</roughness><metalness>0.5</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The sea surface, seen from below. Underwater there is no sky: what is
         overhead is the underside of the water, which is bright, roughly flat,
         and the thing that tells you which way is up. Rendering it removes the
         worst artefact of the old scene, where the seabed appeared to float in
         an unbounded void because nothing bounded the view upward. -->
    <model name="sea_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><mesh><uri>model://uuv_mode_aware_navigation/models/meshes/sea_surface.obj</uri></mesh></geometry>
          <!-- Semi-transparent so the sky colour shows through from below and
               the water reads as a boundary rather than a lid. <transparency>
               is the element ogre2 honours; an alpha in <diffuse> alone does
               not blend. -->
          <transparency>0.45</transparency>
          <material>
            <ambient>0.10 0.22 0.28 1</ambient>
            <diffuse>0.16 0.34 0.44 1</diffuse>
            <specular>0.60 0.72 0.80 1</specular>
            <emissive>0.10 0.20 0.26 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://uuv_mode_aware_navigation/models/textures/water_albedo.png</albedo_map>
                <normal_map>model://uuv_mode_aware_navigation/models/textures/water_normal.png</normal_map>
                <roughness>0.08</roughness>
                <metalness>0.55</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The support vessel. It is not decoration: ultra-short baseline
         positioning interrogates a transceiver held at the surface, so this
         hull is the infrastructure the USBL technique depends on, and the
         E18 family is the case where it leaves station. Having it visible makes
         that dependency something a reader can see rather than read about. -->
    <!-- The support vessel: the infrastructure ultra-short baseline
         positioning depends on, and the thing the E18 family takes away. Its
         transducer hangs over the side on a pole. -->
    <model name="support_vessel">
      <static>true</static>
      <pose>22 16 -1.1 0 0 0.6</pose>
      <link name="link">
        <visual name="hull">
          <geometry><mesh><uri>model://uuv_mode_aware_navigation/models/meshes/ship.obj</uri></mesh></geometry>
          <material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.56 0.58 0.60 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <pbr><metal><roughness>0.45</roughness><metalness>0.35</metalness></metal></pbr></material>
        </visual>
        <visual name="usbl_pole"><pose>2.0 2.6 -1.6 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>3.4</length></cylinder></geometry>
          <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse></material>
        </visual>
        <visual name="usbl_head"><pose>2.0 2.6 -3.4 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.36</length></cylinder></geometry>
          <material><ambient>0.32 0.24 0.06 1</ambient><diffuse>0.84 0.66 0.15 1</diffuse>
            <emissive>0.22 0.16 0.03 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Downloaded scenery. Licences are recorded in NOTICE and differ per
         asset: the fish and the Stylaster coral are CC0 and ship with this
         repository; the jellyfish, statue and plant pack are Sketchfab Standard,
         which permits use but NOT redistribution, so the release export leaves
         them out and the world tolerates their absence.

         glTF is Y-up and Gazebo is Z-up, hence the +90 degree roll on each.
         Scales convert the models' own units to metres.

         The Greek statue from the same batch is NOT here. It segfaults
         Gazebo in gz::common::AssimpLoader::CreateMaterial , a null
         dereference inside the loader, reproducible headless, and not fixed by
         flattening its texture folder or stripping its metallicRoughness maps.
         Four of the five downloaded models load cleanly; that one is a library
         bug rather than an asset problem, and it takes the whole server with
         it, so it stays out. -->

















    <!-- Downloaded scenery. Scales are derived from each model's TRUE bounding
         box, computed by walking the glTF scene graph and applying node
         transforms rather than by reading accessor min/max. Those differ: the plant
         pack measures 18.9 units by the first method and 81 by the second, so
         a scale taken from the raw accessors made every plant a third of the
         size it should be and the whole batch went unnoticed in the scene.

         glTF is Y-up and Gazebo is Z-up, hence the +90 degree roll on each. -->






















    <!-- Downloaded scenery. Scales come from each model's TRUE bounding box,
         computed by walking the glTF scene graph with node transforms applied,
         not from raw accessor min/max. Those disagree badly: the plant pack
         measures 18.9 units one way and 81 the other.

         Up-axis is per model, not global. The plant pack is tallest along X and
         the jellyfish along Y, so a single blanket roll of +90 degrees stood the
         jellyfish up correctly and laid every plant on its side. -->































    <!-- Weed. Dynamic, not static: each is rocked by the fish_school node with a
         slow angular velocity, and because the model origin sits at the base of
         the stems the rotation pivots at the holdfast rather than the middle.
         The sway follows the ocean current, so turning the current up leans the
         whole bed over.

         Honest limit: this bends the WHOLE plant from its base. Moving only the
         fronds while the stems stay put needs either a rigged mesh with bones or
         a vertex shader, and this model has neither. At survey altitude the
         difference is not visible; up close it is. -->



















    <!-- Weed. The plant pack's growth axis is Y (its bounding box runs
         y = -0.34 .. 17.12, sitting on zero and growing up), so roll +90
         stands it in Z and puts the pivot at the holdfast.

         Dynamic, because the fish_school node leans each clump downstream and
         sways it. That lean is CLOSED-LOOP on an integrated angle: the velocity
         plugin holds whatever rate it is given, so any constant term is a
         constant rotation and the clump ends up flat on the seabed. It looks
         exactly like a wrong up-axis and is not. -->





















    <!-- Gravel and cobble. Texture gives the seabed grain; only geometry gives
         it shadows, which is what stops ground reading as a picture on a plane.
         Scales are deliberately non-uniform and flattened in z so the pieces
         sit like stones rather than float like marbles. -->
    <model name="gravel">
      <static>true</static>
      <link name="link">
        <visual name="g0"><pose>16.18 -11.43 -19.98 1.44 1.11 1.47</pose>
