    <model name="acoustic_beacon">
      <static>true</static>
      <pose>-14 -14 -20 0 0 0</pose>
      <link name="link">
        <visual name="base">
          <geometry><cylinder><radius>0.6</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.18 0.16 0.12 1</ambient><diffuse>0.35 0.31 0.22 1</diffuse></material>
        </visual>
        <visual name="mast"><pose>0 0 1.4 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.22 0.20 0.16 1</ambient><diffuse>0.42 0.38 0.28 1</diffuse></material>
        </visual>
        <visual name="transducer"><pose>0 0 2.85 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material>
            <ambient>0.35 0.22 0.05 1</ambient><diffuse>0.85 0.55 0.12 1</diffuse>
            <emissive>0.45 0.26 0.03 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= vehicle ================= -->
    <!-- Configured as an untethered AUV. The frame is BlueROV2 Heavy because
         that is the vehicle class the study's mass, size and lamp geometry are
         taken from, but there is no tether: this study is about a vehicle that
         has to resolve its own position without anything overhead, and a
         umbilical in the scene would contradict the premise. Every sensor sits
         where its measurement is taken from: camera and coaxial lamp at the
         bow of the main enclosure, the off-axis lamp on a rigid boom at the
         0.35 m baseline the optical result depends on, the laser on the
         forward frame, and the acoustic head flush under the battery tube. -->
    <model name="bluerov2">
      <!-- Not static, because the demonstrator moves it and the camera view has
           to be genuinely re-rendered as it goes. But not simulated either: the
           vehicle node writes this model's pose from the true state it
           integrates, and the link below is kinematic with gravity off so that
           the physics engine leaves the pose alone between writes.

           Both of those flags are load-bearing. Without them the model is an
           ordinary rigid body with no buoyancy (buoyancy is deliberately off,
           see the note near the top of this file), so gravity accelerates it
           downwards between pose writes and each write snaps it back. At the
           rate the vehicle node runs that is a violent vertical judder several
           times a second, and it appears the moment the model stops being
           driven by a velocity plugin: commanding velocity every tick had been
           overwriting the fall before it could be seen.

           The fidelity this buys is the fidelity the study declares. The
           dynamics behind every reported number are the first-order response in
           mission.py, stated as a limitation there; a thruster-allocation model
           would add tuning surface without moving any reported quantity. -->
      <static>false</static>
      <!-- Spawned at the survey's first waypoint, not at the world origin.
           SurveyMission starts at (-10, -9, -17); spawning at the origin put
           the vehicle 13.45 m from where the mission believed it was, and the
           demonstrator reported that offset as position error for the whole
           run. The two definitions must agree, and this is the one that has to
           follow, because the waypoints define the survey. -->
      <pose>-10 -9 -17 0 0 0</pose>
      <link name="base_link">
        <!-- See the note on the model above: the pose is written, not
             simulated, so the physics engine must not integrate this link. -->
        <kinematic>true</kinematic>
        <gravity>false</gravity>
        <inertial>
          <mass>11.5</mass>
          <inertia><ixx>0.16</ixx><iyy>0.16</iyy><izz>0.16</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.457 0.338 0.254</size></box></geometry>
        </collision>

        <!-- Vehicle body: the BlueROV2 mesh from CentraleNantesROV/bluerov2
             (Apache-2.0), used at identity as its own URDF does. It replaces a
             hand-built approximation from boxes and cylinders which had the
             right dimensions and the wrong everything else. Attribution is in
             NOTICE and in the README.

             Configured as an untethered AUV: the mesh carries no umbilical, and
             this study is about a vehicle that resolves its own position with
             nothing overhead. -->
        <visual name="body">
          <!-- The mesh is not modelled about its own centre: its bounding box
               runs x -0.363..0.229, y -0.172..0.332, z -0.189..0.242, so the
               body sits up to 80 mm off the link origin. Every sensor placed
               against an assumed centred hull therefore ended up inside it.
               This pose puts the geometric centre on the origin, after which
               the half-extents are 0.296 x 0.252 x 0.215 and things can be
               mounted against numbers that mean something. -->
          <pose>0.0672 -0.0798 -0.0265 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://uuv_mode_aware_navigation/models/meshes/bluerov2.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <!-- Camera at the bow, looking down-forward at the seabed. -->
        <visual name="camera_housing"><pose>0.31 0 -0.06 0 0.35 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular></material>
        </visual>

        <!-- COAXIAL lamp: right beside the lens. Lights the near-field particle
             cloud straight back into the camera  -  the backscatter-limited case. -->
        <visual name="lamp_coaxial"><pose>0.310 0.020 -0.060 0 0.35 0</pose>
          <geometry><sphere><radius>0.021</radius></sphere></geometry>
          <material><ambient>0.45 0.42 0.30 1</ambient><diffuse>0.95 0.90 0.70 1</diffuse>
            <emissive>0.42 0.39 0.28 1</emissive></material>
        </visual>
        <light type="spot" name="lamp_coaxial_light">
          <pose>0.310 0.020 -0.068 0 0 0</pose>
          <direction>0.939 0.0 -0.343</direction>
          <diffuse>0.95 0.92 0.80 1</diffuse>
          <specular>0.4 0.4 0.35 1</specular>
          <attenuation><range>14</range><constant>0.3</constant>
            <linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
          <spot><inner_angle>0.30</inner_angle><outer_angle>0.62</outer_angle><falloff>1.1</falloff></spot>
          <cast_shadows>true</cast_shadows>
        </light>

        <!-- OFF-AXIS lamp on a 0.35 m baseline. The separation pushes the lamp
             cone out of the near field of view, removing the brightest
             backscatter term. This is the geometry behind the ~3 attenuation
             length figure and behind the derived bias. -->
        <!-- THE AXIS, defined once so the rest can be checked against it.

             The axis is the CAMERA'S OPTICAL AXIS: the line the lens looks
             along. Its origin is the lens at (0.310, 0, -0.060) and its
             direction is (0.939, 0, -0.343), i.e. forward and 20 degrees down.

             "Off-axis" means displaced PERPENDICULAR to that line. The number
             that matters is the perpendicular distance, not the straight-line
             range and not the lateral offset in y, and it is what ChannelConfig
             carries as baseline_m.

                 coaxial lamp   0.020 m perpendicular   (declared 0.020)
                 off-axis lamp  0.355 m perpendicular   (declared 0.350)
                                0.286 m behind the lens along the axis

             Being aft of the lens costs nothing: perpendicular distance is
             unchanged by sliding along the axis, and wide-angle practice puts
             the strobe behind the dome port anyway. It buys a boom long enough
             to see, which a lamp sitting level with the lens did not have.

             Why the perpendicular distance is the thing: the lamp cone and the
             camera cone overlap in a volume of water, that volume scatters
             light straight back into the lens, and moving the lamp sideways is
             what shrinks it. Slide the lamp along the axis and the overlap
             barely changes; move it perpendicular and it collapses. That is the
             whole mechanism behind 3 attenuation lengths against 1.5. -->
        <visual name="lamp_arm_clamp"><pose>0.150 -0.230 -0.040 0 0 0</pose>
          <geometry><cylinder><radius>0.019</radius><length>0.055</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <pbr><metal><roughness>0.45</roughness><metalness>0.65</metalness></metal></pbr></material>
        </visual>
        <visual name="lamp_arm_seg1"><pose>0.1200 -0.2700 -0.0350 0 1.4711 -2.2143</pose>
          <geometry><cylinder><radius>0.0125</radius><length>0.1005</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <pbr><metal><roughness>0.4</roughness><metalness>0.7</metalness></metal></pbr></material>
        </visual>
        <visual name="lamp_arm_knuckle"><pose>0.090 -0.310 -0.030 0 0 0</pose>
          <geometry><sphere><radius>0.0175</radius></sphere></geometry>
          <material><ambient>0.07 0.07 0.08 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <pbr><metal><roughness>0.35</roughness><metalness>0.75</metalness></metal></pbr></material>
        </visual>
        <visual name="lamp_arm_seg2"><pose>0.0550 -0.3300 -0.0250 0 1.4474 -2.6224</pose>
          <geometry><cylinder><radius>0.0115</radius><length>0.0812</length></cylinder></geometry>
          <material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <pbr><metal><roughness>0.4</roughness><metalness>0.7</metalness></metal></pbr></material>
        </visual>
        <visual name="lamp_offaxis"><pose>0.020 -0.350 -0.020 0 1.22 -0.30</pose>
          <geometry><cylinder><radius>0.030</radius><length>0.048</length></cylinder></geometry>
          <material><ambient>0.45 0.42 0.30 1</ambient><diffuse>0.95 0.90 0.70 1</diffuse>
            <emissive>0.42 0.39 0.28 1</emissive></material>
        </visual>
        <light type="spot" name="lamp_offaxis_light">
          <pose>0.020 -0.350 -0.020 0 0 0</pose>
          <direction>0.919 -0.195 -0.343</direction>
          <diffuse>0.92 0.90 0.80 1</diffuse>
          <specular>0.35 0.35 0.32 1</specular>
          <attenuation><range>14</range><constant>0.3</constant>
            <linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
          <spot><inner_angle>0.28</inner_angle><outer_angle>0.58</outer_angle><falloff>1.2</falloff></spot>
          <cast_shadows>true</cast_shadows>
        </light>

        <!-- Green laser profiler: the second optical modality, with a different
             failure envelope from the camera. -->
        <visual name="lidar_head"><pose>0.240 0.120 -0.232 0 0.5 0</pose>
          <geometry><cylinder><radius>0.026</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.06 0.09 0.07 1</ambient><diffuse>0.46 0.44 0.38 1</diffuse>
            <emissive>0.02 0.06 0.03 1</emissive>
            <pbr><metal><roughness>0.5</roughness><metalness>0.5</metalness></metal></pbr></material>
        </visual>

        <!-- Downward acoustic head: DVL bottom lock and sonar altimetry. -->
        <visual name="acoustic_head"><pose>0.02 0 -0.235 0 0 0</pose>
          <geometry><cylinder><radius>0.062</radius><length>0.038</length></cylinder></geometry>
          <material><ambient>0.20 0.16 0.06 1</ambient><diffuse>0.48 0.38 0.14 1</diffuse></material>
        </visual>


        <sensor name="camera" type="camera">
          <pose>0.31 0 -0.06 0 0.35 0</pose>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <topic>/paper2/camera</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>60</far></clip>
          </camera>
        </sensor>

        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <topic>/paper2/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- The vehicle carries no velocity or thruster plugin on purpose.

           Its pose is written each step by the vehicle node, over the world's
           set_pose service, from the true state that node integrates. Gazebo
           renders this study; it does not simulate it.

           This replaced gz-sim-velocity-control-system, which could not do the
           job for three measured reasons:

             * it never moved this model vertically. Commanding {x: 0.2, z: 0.3}
               straight over gz transport, bypassing ROS, gave x = 0.19999999999953
               and z = 0.0 exactly, the horizontal axis tracking to thirteen
               decimal places while the vertical one never moved at all. Ruled
               out in turn: the buoyancy system (see the note near the top of
               this file), a joint or gravity override (the model has neither),
               the ROS bridge (bypassed), and link-level rather than model-level
               control (tried, no change). Altitude is the strongest action the
               manager has, so this made the one action most worth showing the
               one that could not be seen;

             * it reads its linear vector in the model's own frame while the
               vehicle node holds velocity in the world frame, so the rendered
               model crabbed off by the heading angle once the vehicle turned;

             * it integrates on the sim clock while the ROS nodes run on the
               wall clock, nothing here bridging /clock. At the real-time factor
               this world actually achieves the rendered vehicle covered a
               fraction of the true distance and its heading drifted without
               bound, so "forward" stopped meaning forward.

           Setting the pose removes all three: no second integrator to disagree,
           a pose is unambiguously world-framed, and every axis is set rather
           than commanded. The vehicle no longer collides with anything, which
           costs nothing in a kinematic study whose vehicle model has no contact
           dynamics in the first place. -->

      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>bluerov2</robot_base_frame>
        <odom_topic>/model/bluerov2/odometry</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>Mode-aware survey</title><property key="showTitleBar" type="bool">false</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.34 0.36 0.36</ambient_light>
        <background_color>0.05 0.16 0.22</background_color>
        <!-- Looking along +X, which is the compass north the arrow keys use, so
             that at startup 'arrow up' is 'away from you'. -->
        <camera_pose>-19 0 -15.6 0 0.22 0</camera_pose>
      </plugin>
      <!-- These three are machinery, not controls: they keep the scene in sync,
           give the mouse its orbit/zoom, and provide the follow services. Left
           unconfigured, gz-gui gives each one a docked card several hundred
           pixels tall explaining what it does, which is how the right-hand side
           of the window fills with text nobody needs to read. Marking them
           invisible keeps the behaviour and removes the furniture. -->
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="visible" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="visible" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="visible" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="height" type="double">72</property>
          <property key="y" type="double">1</property>
          <anchors target="3D View">
            <line own="left" target="left"/><line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step>
        <use_event>true</use_event>
      </plugin>

      <!-- The vehicle's own camera, docked inside the same window as the 3D
           view, so a session is one window rather than three. The topic is the
           degraded frame republished onto gz transport by the bridge: what the
           vehicle sees after the water column, not the clean render. -->
      <plugin filename="ImageDisplay" name="Vehicle camera">
        <gz-gui>
          <title>Vehicle camera</title>
          <property key="state" type="string">docked</property>
          <property key="width" type="double">420</property>
          <property key="height" type="double">340</property>
          <property key="resizable" type="bool">true</property>
        </gz-gui>
        <topic>/uuv/camera_degraded</topic>
        <topic_picker>false</topic_picker>
      </plugin>

    </gui>

  </world>
</sdf>
