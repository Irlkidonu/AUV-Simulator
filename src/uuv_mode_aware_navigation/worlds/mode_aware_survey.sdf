          <material><ambient>0.22 0.24 0.24 1</ambient><diffuse>0.62 0.66 0.66 1</diffuse>
            <emissive>0.10 0.11 0.11 1</emissive></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
