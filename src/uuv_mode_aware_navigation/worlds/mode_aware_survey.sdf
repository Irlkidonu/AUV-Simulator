    <!-- Marine snow. Fine particulate drifting with the flow, which is what
         makes a current visible at all: water itself shows nothing. Each is a
         speck given the ambient current as its initial velocity. It is also
         honest about the optics: this is the material that produces the
         backscatter the coaxial channel dies of. -->

    <model name="snow_0">
      <static>false</static>
      <pose>8.90 -3.98 -15.62 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.001</mass>
          <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
