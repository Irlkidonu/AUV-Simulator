    <!-- Fish, each its own model so each can move. VelocityControl accepts an
         initial linear and angular velocity and holds them, so a constant surge
         with a small yaw rate is a fish swimming a slow circle forever, with no
         plugin to write and no node to run. Radii and speeds differ per fish so
         the school does not move as one body.

         They swim through the current rather than with it: a fish holding
         station in a two-knot flow is a thing worth seeing, and it gives the
         current somewhere to show itself besides the vehicle's cross-track. -->

    <model name="fish_0">
      <static>false</static>
      <pose>2.58 8.58 -17.81 0 -0.09 1.06</pose>
      <link name="link">
        <gravity>false</gravity>  <!-- see SCENERY PHYSICS above -->
        <inertial><mass>0.4</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="v">
          <geometry><mesh><uri>model://uuv_mode_aware_navigation/models/meshes/fish_1.obj</uri><scale>1.24 1.24 1.24</scale></mesh></geometry>
          <material><ambient>0.20 0.23 0.26 1</ambient><diffuse>0.66 0.72 0.76 1</diffuse>
            <specular>0.35 0.38 0.40 1</specular>
            <pbr><metal><roughness>0.35</roughness><metalness>0.25</metalness></metal></pbr>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <topic>/model/fish_0/cmd_vel</topic>
      </plugin>
    </model>

    <model name="fish_1">
      <static>false</static>
      <pose>10.93 5.43 -18.32 0 -0.05 0.87</pose>
      <link name="link">
        <gravity>false</gravity>  <!-- see SCENERY PHYSICS above -->
        <inertial><mass>0.4</mass>
