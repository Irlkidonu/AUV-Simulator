    <!-- Reef scenery. Corals and sponges are generated meshes
         (scripts/make_scenery.py) rather than primitives, because branching
         and radial structure is what separates something alive from a rock.

         Colour is split deliberately: <diffuse> holds the true pigment, and
         <ambient> is kept low and desaturated. At this depth the red end has
         already gone from the downwelling light, so the reef reads brown-grey
         until the vehicle's lamps reach it and it flushes back to colour. That
         is the same physics the optical channel of this study rests on, and it
         is worth being able to see it happen. -->
    <model name="reef">
      <static>true</static>
      <link name="link">
